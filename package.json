{
  "name": "dsh-guangke",
  "version": "0.3.2",
  "type": "module",
  "description": "光刻 LITHO - 把一句话刻成一张图。87 种插画/二次元/图文版式/信息图风格，出的是能直接压字的干净底图；支持一次出四张、程序化叠标题、出图历史。公众号封面、内文配图、小红书首图。",
  "license": "MIT",
  "author": "LITHO contributors",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "image",
    "illustration",
    "cover",
    "seedream",
    "dashscope",
    "prompt",
    "xiaohongshu",
    "wechat",
    "cover-generator"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib-thumb.mjs",
    "cordis.patch.yml",
    "data/styles.json",
    "data/thumbs/*.webp",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "data/presets.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
