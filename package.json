{
  "name": "dsh-guangke",
  "version": "0.1.0",
  "type": "module",
  "description": "光刻 LITHO — 把一句话刻成一张图。81 种插画/图文风格，出的是能直接压字的干净底图：公众号封面、内文配图、小红书首图。",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "image",
    "illustration",
    "cover",
    "seedream",
    "dashscope",
    "prompt",
    "xiaohongshu"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "data/styles.json",
    "data/thumbs/*.webp",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
